<Window x:Class="ZillaTerm.App.Views.RetrievePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.RetrieveTitle}" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <!-- En-tête : le compte dont le mot de passe sera récupéré, et son safe. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Image Source="{StaticResource IconKey}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SafeText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="16,4,16,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyButton" Content="{x:Static loc:Strings.RetrieveAndCopy}" IsDefault="True" Click="OnCopy" />
                <Button x:Name="CancelButton" Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="{x:Static loc:Strings.RetrieveWorking}" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" Visibility="Collapsed" />
        </DockPanel>

        <StackPanel Margin="16,12,16,8">
            <!-- Ce qui va se passer : audit, presse-papiers. -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="•" Margin="0,0,6,0" />
                <TextBlock x:Name="AuditText" Text="{x:Static loc:Strings.RetrieveAudited}" TextWrapping="Wrap" />
            </DockPanel>
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="•" Margin="0,0,6,0" />
                <TextBlock x:Name="ClipboardText" TextWrapping="Wrap" />
            </DockPanel>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="{x:Static loc:Strings.ReasonLabel}" Target="{Binding ElementName=ReasonBox}" />
                <TextBox Grid.Column="1" Grid.ColumnSpan="3" x:Name="ReasonBox" Margin="0,0,0,8" VerticalContentAlignment="Center"
                         ToolTip="{x:Static loc:Strings.ReasonTip}" />
                <Label Grid.Row="1" Content="{x:Static loc:Strings.TicketLabel}" Target="{Binding ElementName=TicketSystemBox}" />
                <Grid Grid.Row="1" Grid.Column="1">
                    <TextBox x:Name="TicketSystemBox" VerticalContentAlignment="Center" ToolTip="{x:Static loc:Strings.TicketSystemTip}"
                             AutomationProperties.Name="{x:Static loc:Strings.TicketSystemPlaceholder}" />
                    <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=TicketSystemBox}"
                               Text="{x:Static loc:Strings.TicketSystemPlaceholder}" Margin="6,0,0,0" />
                </Grid>
                <Grid Grid.Row="1" Grid.Column="3">
                    <TextBox x:Name="TicketIdBox" VerticalContentAlignment="Center" ToolTip="{x:Static loc:Strings.TicketIdTip}"
                             AutomationProperties.Name="{x:Static loc:Strings.TicketIdPlaceholder}" />
                    <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=TicketIdBox}"
                               Text="{x:Static loc:Strings.TicketIdPlaceholder}" Margin="6,0,0,0" />
                </Grid>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{x:Static loc:Strings.RetrieveReasonHint}"
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </Grid>
            <Border x:Name="ErrorPanel" Style="{StaticResource ErrorBanner}" Margin="0,8,0,0" Visibility="Collapsed">
                <views:ErrorLine x:Name="ErrorMessage" />
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
