<Window x:Class="ZillaTerm.App.Views.TransferHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.HistoryTitle}" Width="1100" Height="540" MinWidth="640" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <ComboBox x:Name="FilterBox" DockPanel.Dock="Left" MinWidth="180" Margin="0,0,12,0" SelectedIndex="0">
                <ComboBoxItem Content="{x:Static loc:Strings.HistoryFilterAll}" />
                <ComboBoxItem Content="{x:Static loc:Strings.HistoryFilterUploads}" />
                <ComboBoxItem Content="{x:Static loc:Strings.HistoryFilterDownloads}" />
            </ComboBox>
            <TextBlock Text="{x:Static loc:Strings.HistoryNote}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" Margin="8,0,0,0" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ChecksButton" Content="{x:Static loc:Strings.HistoryChecks}" Click="OnChecks" IsEnabled="False" />
                <Button x:Name="OpenFolderButton" Content="{x:Static loc:Strings.HistoryOpenFolder}" Click="OnOpenFolder" IsEnabled="False" Margin="8,0,0,0" />
                <!-- Action destructive à l'écart des autres. -->
                <Button x:Name="ClearButton" Content="{x:Static loc:Strings.HistoryClear}" Click="OnClear" Margin="32,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" AlternatingRowBackground="{DynamicResource AlternateRowBrush}" ClipboardCopyMode="IncludeHeader"
                      MouseDoubleClick="OnRowDoubleClick" />
            <TextBlock x:Name="EmptyText" Text="{x:Static loc:Strings.HistoryEmpty}" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
