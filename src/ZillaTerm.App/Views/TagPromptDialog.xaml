<Window x:Class="ZillaTerm.App.Views.TagPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.TagPromptTitle}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeadingText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
        <TextBlock Text="{x:Static loc:Strings.TagPromptHelp}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12" />
        <!-- Une case par étiquette (pastille de sa couleur), puis « Aucune étiquette ». -->
        <StackPanel x:Name="Choices" Margin="0,0,0,6" />
        <TextBlock x:Name="GuessText" Text="{x:Static loc:Strings.TagPromptGuessed}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,2,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button IsDefault="True" Click="OnOk">
                <AccessText Text="{x:Static loc:Strings.TagPromptAdd}" />
            </Button>
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
