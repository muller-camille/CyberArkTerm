<Window x:Class="ZillaTerm.App.Views.DutyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.DutyTitle}" Width="660" Height="700" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" Click="OnClose" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                       AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <!-- Enregistrement et astreintes précédentes, sous le texte de l'équipe. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{x:Static loc:Strings.DutyRecordingSection}" Style="{StaticResource SectionTitle}" />
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="RecordButton" DockPanel.Dock="Left" Click="OnRecord" MinWidth="210">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#D32F2F" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <Rectangle x:Name="StopSquare" Width="10" Height="10" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <AccessText x:Name="RecordLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
            <TextBlock Style="{StaticResource OptionHelp}" Text="{x:Static loc:Strings.DutyRecordingHelp}" Margin="0,4,0,8" />
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="NoteButton" DockPanel.Dock="Right" Click="OnAddNote" Margin="8,0,0,0">
                    <AccessText Text="{x:Static loc:Strings.DutyAddNote}" />
                </Button>
                <Grid>
                    <TextBox x:Name="NoteBox" AutomationProperties.Name="{x:Static loc:Strings.DutyNoteName}" MaxLength="2000"
                             KeyDown="OnNoteKeyDown" TextChanged="OnNoteChanged" />
                    <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=NoteBox}"
                               Text="{x:Static loc:Strings.DutyNotePlaceholder}" Margin="6,0,0,0" />
                </Grid>
            </DockPanel>
            <Button x:Name="CaptureButton" Click="OnCapture" HorizontalAlignment="Left" ToolTip="{x:Static loc:Strings.DutyCaptureTip}"
                    AutomationProperties.HelpText="{x:Static loc:Strings.DutyCaptureTip}">
                <AccessText Text="{x:Static loc:Strings.DutyCaptureRdp}" />
            </Button>

            <TextBlock Text="{x:Static loc:Strings.DutyPreviousSection}" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button x:Name="ExportButton" Click="OnExport">
                        <AccessText Text="{x:Static loc:Strings.DutyExportReport}" />
                    </Button>
                    <Button x:Name="DeleteButton" Click="OnDelete" Margin="0,6,0,0">
                        <AccessText Text="{x:Static loc:Strings.DutyDelete}" />
                    </Button>
                </StackPanel>
                <ListBox x:Name="JournalList" Height="110" SelectionChanged="OnJournalSelected" MouseDoubleClick="OnJournalDoubleClick"
                         AutomationProperties.Name="{x:Static loc:Strings.DutyPreviousSection}" />
            </DockPanel>
            <TextBlock Text="{x:Static loc:Strings.DutyReportNotEncrypted}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock x:Name="TeamTitle" DockPanel.Dock="Top" Text="{x:Static loc:Strings.DutyTeamTextSection}" Style="{StaticResource SectionTitle}" />
        <TextBlock x:Name="NoTeamText" DockPanel.Dock="Top" Text="{x:Static loc:Strings.DutyNoText}" Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
        <!-- Texte brut de l'équipe : sélectionnable (numéros à copier), jamais interprété (ni lien, ni mise en forme). -->
        <TextBox x:Name="TeamText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 FontSize="14" Padding="8,6" AutomationProperties.LabeledBy="{Binding ElementName=TeamTitle}" />
    </DockPanel>
</Window>
