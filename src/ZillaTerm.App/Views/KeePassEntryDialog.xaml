<Window x:Class="ZillaTerm.App.Views.KeePassEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Image Source="{StaticResource IconKeePass}" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="VaultText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Static loc:Strings.KeePassFolderTip}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="16,4,16,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="SaveButton" Content="{x:Static loc:Strings.Save}" IsDefault="True" Click="OnSave" />
                <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
            <views:ErrorLine x:Name="ErrorText" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>

        <Grid Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{x:Static loc:Strings.KeePassTitleLabel}" Target="{Binding ElementName=TitleBox}" />
            <TextBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="TitleBox" Margin="0,0,0,8" VerticalContentAlignment="Center" />
            <Label Grid.Row="1" Content="{x:Static loc:Strings.KeePassGroupLabel}" Target="{Binding ElementName=GroupBox}" />
            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="GroupBox" IsEditable="True" Margin="0,0,0,8" />
            <Label Grid.Row="2" Content="{x:Static loc:Strings.KeePassUrlLabel}" Target="{Binding ElementName=UrlBox}" />
            <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                <TextBox x:Name="UrlBox" VerticalContentAlignment="Center" TextChanged="OnUrlChanged" />
                <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=UrlBox}" Text="{x:Static loc:Strings.KeePassUrlHint}" Margin="6,0,0,0" />
            </Grid>
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TargetText" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,8" />
            <Label Grid.Row="4" Content="{x:Static loc:Strings.KeePassUserLabel}" Target="{Binding ElementName=UserBox}" />
            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="UserBox" Margin="0,0,0,8" VerticalContentAlignment="Center" TextChanged="OnUrlChanged" />
            <Label Grid.Row="5" x:Name="PasswordLabel" Content="{x:Static loc:Strings.KeePassPasswordLabel}" Target="{Binding ElementName=PasswordBox}" />
            <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                <PasswordBox x:Name="PasswordBox" VerticalContentAlignment="Center" PasswordChanged="OnPasswordChanged" />
                <TextBox x:Name="PasswordText" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="OnPasswordTextChanged"
                         AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" />
                <TextBlock x:Name="PasswordHint" Text="{x:Static loc:Strings.KeePassPasswordUnchanged}" Foreground="{DynamicResource MutedBrush}"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" />
            </Grid>
            <CheckBox Grid.Row="5" Grid.Column="2" x:Name="ShowBox" Margin="8,0,0,8" VerticalAlignment="Center"
                      Checked="OnShowChanged" Unchecked="OnShowChanged">
                <AccessText Text="{x:Static loc:Strings.KeePassShowPassword}" />
            </CheckBox>
            <Label Grid.Row="6" Content="{x:Static loc:Strings.KeePassNotesLabel}" Target="{Binding ElementName=NotesBox}" VerticalAlignment="Top" />
            <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NotesBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />
        </Grid>
    </DockPanel>
</Window>
