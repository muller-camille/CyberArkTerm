    <!-- Palette : barre d'outils claire, bandeau latéral sombre, accent bleu. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1565C0" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#E3EEFB" />
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#C9D1DA" />
    <SolidColorBrush x:Key="SideStripBrush" Color="#2B3A4A" />
    <SolidColorBrush x:Key="SidePanelBrush" Color="#F7F9FB" />
    <SolidColorBrush x:Key="TabStripBrush" Color="#DCE3EA" />
    <SolidColorBrush x:Key="StatusBrush" Color="#2B3A4A" />
    <!-- Texte secondaire : 5,6:1 sur le panneau latéral (seuil 4,5:1). -->
    <SolidColorBrush x:Key="MutedBrush" Color="#5A6573" />
    <SolidColorBrush x:Key="SidePanelForeground" Color="#1F2933" />

    <!-- Sélection toujours visible quand la liste n'a pas le focus (menu contextuel ouvert, clic ailleurs) :
         le gris « inactif » de Windows se confond avec le fond des panneaux. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CCE4F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1F2933" />
    <LinearGradientBrush x:Key="ToolbarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FBFCFD" Offset="0" />
        <GradientStop Color="#E8EDF2" Offset="1" />
    </LinearGradientBrush>

