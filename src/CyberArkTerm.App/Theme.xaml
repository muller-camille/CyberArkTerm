    <!-- ===== Styles ===== -->

    <!-- Gros bouton icône + libellé de la barre d'outils. -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="MinWidth" Value="66" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Focusable" Value="False" />
        <!-- Un bouton grisé dit pourquoi dans son infobulle. -->
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCE8F5" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#A9C7E8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C4DBF2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmallToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style x:Key="SmallIcon" TargetType="Image">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>

    <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Margin" Value="6,0,-6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolIcon" TargetType="Image">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,6" />
        <Setter Property="Fill" Value="#C9D1DA" />
    </Style>

    <!-- Onglets verticaux du bandeau latéral (« Sessions », « Favoris »). -->
    <!-- L'en-tête et le contenu héritent tous deux de Foreground (arbre logique) : le contenu de chaque
         onglet latéral fixe donc sa propre couleur de texte (SidePanelForeground). -->
    <Style x:Key="SideTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="#C8D3DE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="7,14" Margin="0,0,0,2">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center">
                            <ContentPresenter.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </ContentPresenter.LayoutTransform>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3A4D61" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SideTabControl" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SideTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Background="{StaticResource SideStripBrush}">
                            <StackPanel IsItemsHost="True" Margin="0,4,0,0" />
                        </Border>
                        <Border Background="{StaticResource SidePanelBrush}" BorderBrush="{StaticResource ToolbarBorderBrush}"
                                BorderThickness="0,0,1,0">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Onglets de la zone principale (« Accueil », sessions SSH et Bureau à distance). -->
    <Style x:Key="MainTabItem" TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="#EEF2F6" BorderBrush="#BAC5D1" BorderThickness="1,1,1,0"
                            CornerRadius="5,5,0,0" Padding="12,5,14,5" Margin="0,0,3,-1">
                        <Grid>
                            <Border x:Name="Accent" Height="3" VerticalAlignment="Top" Margin="-12,-5,-14,0"
                                    CornerRadius="5,5,0,0" Background="Transparent" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F6F8FA" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White" />
                            <Setter TargetName="Accent" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MainTabControl" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource MainTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource TabStripBrush}" Padding="6,6,6,0"
                                BorderBrush="#BAC5D1" BorderThickness="0,0,0,1">
                            <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                        </Border>
                        <Border Background="White">
                            <Grid>
                                <ContentPresenter ContentSource="SelectedContent" />
                                <!-- Onglets Bureau à distance : leur contenu reste ici en permanence (seulement masqué), pour que
                                     le contrôle Bureau à distance ne soit jamais retiré de la fenêtre pendant la session. -->
                                <Grid x:Name="RdpLayer" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#2B3A4A" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Texte indicatif affiché dans une zone de saisie vide : Tag = TextBox ciblée. -->
    <Style x:Key="Placeholder" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#8C96A1" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag.Text, RelativeSource={RelativeSource Self}}" Value="">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
