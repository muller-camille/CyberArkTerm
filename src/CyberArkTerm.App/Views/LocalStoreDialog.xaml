<Window x:Class="CyberArkTerm.App.Views.LocalStoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.LocalStoreTitle}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,12">
            <Image Source="{StaticResource IconPermissions}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{x:Static loc:Strings.LocalStorePasswordLabel}" Target="{Binding ElementName=PasswordBox}" />
            <PasswordBox Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,8" VerticalContentAlignment="Center" />
            <Label Grid.Row="1" x:Name="ConfirmLabel" Content="{x:Static loc:Strings.LocalStoreConfirmLabel}" Target="{Binding ElementName=ConfirmBox}" />
            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="ConfirmBox" Margin="0,0,0,8" VerticalContentAlignment="Center" />
        </Grid>
        <ProgressBar x:Name="Progress" Height="6" IsIndeterminate="True" Margin="0,4,0,4" Visibility="Collapsed" />
        <TextBlock x:Name="CapsLockText" Text="{x:Static loc:Strings.CapsLockOn}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,6" Visibility="Collapsed" />
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" IsDefault="True" Click="OnOk" />
            <Button x:Name="CancelButton" Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
