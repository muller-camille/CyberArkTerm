<UserControl x:Class="CyberArkTerm.App.Views.ParallelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CyberArkTerm.App.Localization">
    <DockPanel Background="#1B1F24">
        <!-- Barre de la vue : nombre de sessions, saisie simultanée, choix des sessions, fermeture. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SidePanelBrush}" BorderBrush="{StaticResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{x:Static loc:Strings.ParallelChoose}" Padding="8,2" Click="OnChoose" />
                    <Button Content="{x:Static loc:Strings.ParallelClose}" Padding="8,2" Margin="8,0,0,0" Click="OnClose"
                            ToolTip="{x:Static loc:Strings.ParallelCloseTip}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconParallel}" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ToggleButton x:Name="BroadcastToggle" Margin="16,0,0,0" Padding="8,2" Click="OnBroadcast"
                                  ToolTip="{x:Static loc:Strings.ParallelBroadcastTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨" Margin="0,0,6,0" />
                            <AccessText Text="{x:Static loc:Strings.ParallelBroadcast}" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Saisie simultanée active : bien visible, avec le nombre et le nom des sessions qui reçoivent la saisie. -->
        <Border x:Name="BroadcastBanner" DockPanel.Dock="Top" Background="#F59E0B" Padding="10,5" Visibility="Collapsed">
            <TextBlock x:Name="BroadcastText" Foreground="#1F1300" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="PanesGrid" Margin="2" />
    </DockPanel>
</UserControl>
