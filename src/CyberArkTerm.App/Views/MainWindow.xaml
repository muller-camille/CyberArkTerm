<Window x:Class="CyberArkTerm.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:CyberArkTerm.App"
        xmlns:core="clr-namespace:CyberArkTerm.Core;assembly=CyberArkTerm.Core"
        Title="CyberArkTerm"
        Width="1280" Height="780" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="Find" Executed="OnFind" />
        <CommandBinding Command="Refresh" Executed="OnRefresh" CanExecute="CanRefresh" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="Refresh" />
    </Window.InputBindings>

    <Window.Resources>
        <app:KindIconConverter x:Key="KindIcon" />

        <!-- Menu contextuel commun à l'arbre, à la liste, aux favoris et à l'accueil. -->
        <ContextMenu x:Key="AccountMenu" x:Shared="False" Opened="OnAccountMenuOpened">
            <MenuItem Tag="psm" Header="_Se connecter (PSM)" Click="OnConnectPsm" FontWeight="SemiBold">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconConnect}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Tag="ssh" Header="Se connecter en SS_H (PSMP)" Click="OnConnectSsh">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconSsh}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Connexion _avancée…" Click="OnConnectAdvanced">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconConnectAdvanced}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Tag="fav" Header="Ajouter aux _favoris" Click="OnToggleFavorite">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconStar}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Copier le serveur" Click="OnCopyAddress" />
            <MenuItem Header="Copier l'utilisateur" Click="OnCopyUser" />
            <MenuItem Header="Copier domaine\utilisateur" Click="OnCopyDomainUser" />
        </ContextMenu>

        <!-- Ligne « compte » réutilisée dans les listes (favoris, résultats de recherche). -->
        <DataTemplate x:Key="AccountRow" DataType="{x:Type core:PvwaAccount}">
            <DockPanel Margin="0,2">
                <Image Source="{Binding Converter={StaticResource KindIcon}}" Width="18" Height="18" Margin="0,0,8,0" />
                <StackPanel>
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding UserName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="@" Foreground="Gray" /><Run Text="{Binding Address, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding PlatformId, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SafeName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <Style x:Key="AccountListItem" TargetType="ListBoxItem">
            <Setter Property="ContextMenu" Value="{StaticResource AccountMenu}" />
            <Setter Property="Padding" Value="6,3" />
            <EventSetter Event="MouseDoubleClick" Handler="OnAccountItemDoubleClick" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Barre d'outils ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Click="OnLogout" ToolTip="Fermer la session CyberArk et revenir à l'écran de connexion">
                        <StackPanel>
                            <Image Source="{StaticResource IconLogout}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="Déconnexion" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnExit" ToolTip="Quitter CyberArkTerm">
                        <StackPanel>
                            <Image Source="{StaticResource IconExit}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="Quitter" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConnectButton" Style="{StaticResource ToolButton}" Click="OnConnectDefault"
                            ToolTip="Ouvrir une session sur le compte sélectionné (double-clic / Entrée)">
                        <StackPanel>
                            <Image Source="{StaticResource IconConnect}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="Se connecter" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SshButton" Style="{StaticResource ToolButton}" Click="OnConnectSsh"
                            ToolTip="Ouvrir le compte en SSH via le PSMP">
                        <StackPanel>
                            <Image Source="{StaticResource IconSsh}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="SSH" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AdvancedButton" Style="{StaticResource ToolButton}" Click="OnConnectAdvanced"
                            ToolTip="Choisir le composant, la machine cible, le motif ou le ticket">
                        <StackPanel>
                            <Image Source="{StaticResource IconConnectAdvanced}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="Connexion…" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button x:Name="FavoriteButton" Style="{StaticResource ToolButton}" Click="OnToggleFavorite"
                            ToolTip="Ajouter ou retirer le compte des favoris">
                        <StackPanel>
                            <Image Source="{StaticResource IconStar}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="Favori" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="Refresh" ToolTip="Recharger les comptes depuis le PVWA (F5)">
                        <StackPanel>
                            <Image Source="{StaticResource IconRefresh}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="Actualiser" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnExport" ToolTip="Exporter la liste filtrée en CSV">
                        <StackPanel>
                            <Image Source="{StaticResource IconExport}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="Exporter" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Click="OnSettings" ToolTip="PSMP, composants mémorisés">
                        <StackPanel>
                            <Image Source="{StaticResource IconSettings}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="Paramètres" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Barre d'état ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource StatusBrush}" Padding="10,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="SessionText" Foreground="#C8D3DE" />
                <TextBlock x:Name="CountText" Foreground="White" Margin="0,0,16,0" />
                <ProgressBar x:Name="LoadProgress" Width="140" Height="8" Margin="0,0,16,0" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Foreground="#9FD39F" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Bandeau latéral : sessions / favoris ===== -->
            <TabControl x:Name="SideTabs" Style="{StaticResource SideTabControl}">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconFolder}" Width="14" Height="14" Margin="0,0,6,0">
                                <Image.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </Image.LayoutTransform>
                            </Image>
                            <TextBlock Text="Sessions" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,6">
                            <Grid>
                                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Padding="24,4,4,4"
                                         PreviewKeyDown="OnSearchKeyDown"
                                         ToolTip="Filtrer par serveur, utilisateur, safe, plateforme… (Ctrl+F)" />
                                <Image Source="{StaticResource IconSearch}" Width="14" Height="14" HorizontalAlignment="Left"
                                       Margin="6,0,0,0" IsHitTestVisible="False" />
                                <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=SearchBox}"
                                           Text="Filtrer les sessions…" Margin="26,0,0,0" />
                            </Grid>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="Grouper par" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="GroupByBox" SelectionChanged="OnGroupByChanged" Padding="6,2" />
                            </DockPanel>
                        </StackPanel>
                        <TreeView x:Name="SessionTree" BorderThickness="0" Background="Transparent" Padding="2,0,0,0"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectedItemChanged="OnTreeSelectionChanged" KeyDown="OnTreeKeyDown">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type app:FolderNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Image Source="{StaticResource IconFolder}" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Count, StringFormat=' ({0})'}" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type app:AccountNode}">
                                    <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Details}">
                                        <Image Source="{Binding Converter={StaticResource KindIcon}}" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Title}" />
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="ContextMenu" Value="{StaticResource AccountMenu}" />
                                    <EventSetter Event="MouseDoubleClick" Handler="OnTreeItemDoubleClick" />
                                    <EventSetter Event="MouseRightButtonDown" Handler="OnTreeItemRightClick" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </DockPanel>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconStar}" Width="14" Height="14" Margin="0,0,6,0">
                                <Image.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </Image.LayoutTransform>
                            </Image>
                            <TextBlock Text="Favoris" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Comptes favoris" Style="{StaticResource SectionTitle}" Margin="10,10,10,6" />
                        <TextBlock DockPanel.Dock="Top" x:Name="NoFavoritesText" Margin="10,0,10,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Aucun favori. Clic droit sur un compte → « Ajouter aux favoris », ou bouton « Favori »." />
                        <ListBox x:Name="FavoritesList" BorderThickness="0" Background="Transparent"
                                 ItemTemplate="{StaticResource AccountRow}" ItemContainerStyle="{StaticResource AccountListItem}"
                                 SelectionChanged="OnListSelectionChanged" KeyDown="OnListKeyDown" />
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource TabStripBrush}" />

            <!-- ===== Zone principale : onglets ===== -->
            <TabControl Grid.Column="2" x:Name="MainTabs" Style="{StaticResource MainTabControl}">
                <TabItem x:Name="HomeTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconHome}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Accueil" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="980" Margin="36,28,36,24" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                                <Image Source="{StaticResource IconConnect}" Width="54" Height="54" Margin="0,0,14,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CyberArkTerm" FontSize="26" FontWeight="SemiBold" Foreground="#2B3A4A" />
                                    <TextBlock x:Name="WelcomeText" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Connexion rapide -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="4"
                                    Background="White" Margin="0,0,0,4">
                                <Grid>
                                    <TextBox x:Name="QuickBox" BorderThickness="0" FontSize="15" Padding="36,8,8,8"
                                             TextChanged="OnQuickChanged" PreviewKeyDown="OnQuickKeyDown" />
                                    <Image Source="{StaticResource IconSearch}" Width="18" Height="18" HorizontalAlignment="Left"
                                           Margin="10,0,0,0" IsHitTestVisible="False" />
                                    <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=QuickBox}" FontSize="15"
                                               Text="Connexion rapide : tapez un serveur ou un compte, puis Entrée" Margin="38,0,0,0" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" x:Name="QuickResultsPanel" BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="1"
                                    CornerRadius="0,0,4,4" Visibility="Collapsed" Margin="0,0,0,8">
                                <ListBox x:Name="QuickResults" BorderThickness="0" MaxHeight="320"
                                         ItemTemplate="{StaticResource AccountRow}" ItemContainerStyle="{StaticResource AccountListItem}"
                                         SelectionChanged="OnListSelectionChanged" KeyDown="OnListKeyDown" />
                            </Border>

                            <Grid Grid.Row="3" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Image Source="{StaticResource IconHistory}" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Sessions récentes" Style="{StaticResource SectionTitle}" Margin="0" />
                                    </DockPanel>
                                    <Border BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <TextBlock x:Name="NoRecentText" Margin="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                       Text="Les sessions que vous ouvrez apparaîtront ici." />
                                            <ListBox x:Name="RecentList" BorderThickness="0" Background="Transparent" MaxHeight="360"
                                                     MouseDoubleClick="OnRecentDoubleClick" KeyDown="OnRecentKeyDown">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type core:RecentSession}">
                                                        <DockPanel Margin="2,3">
                                                            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"
                                                                       Text="{Binding When, StringFormat='dd/MM HH:mm'}" VerticalAlignment="Center" />
                                                            <Image Source="{Binding Converter={StaticResource KindIcon}}" Width="18" Height="18" Margin="0,0,8,0" />
                                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text="{Binding Mode, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Raccourcis" Style="{StaticResource SectionTitle}" />
                                    <Border Background="{StaticResource AccentLightBrush}" CornerRadius="4" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run FontWeight="SemiBold" Text="Double-clic / Entrée" /> : ouvrir la session</TextBlock>
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run FontWeight="SemiBold" Text="Clic droit" /> : PSM, SSH, connexion avancée, favoris</TextBlock>
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run FontWeight="SemiBold" Text="Ctrl+F" /> : filtrer les sessions</TextBlock>
                                            <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="F5" /> : recharger depuis le PVWA</TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="AccountsTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconList}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Tous les comptes" />
                        </StackPanel>
                    </TabItem.Header>
                    <DataGrid x:Name="AccountsGrid" Margin="0"
                              AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E9EE"
                              HeadersVisibility="Column" AlternatingRowBackground="#F7F9FC"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ClipboardCopyMode="IncludeHeader" ContextMenu="{StaticResource AccountMenu}"
                              SelectionChanged="OnGridSelectionChanged" PreviewKeyDown="OnGridKeyDown">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="MouseDoubleClick" Handler="OnGridRowDoubleClick" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="30" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Converter={StaticResource KindIcon}}" Width="16" Height="16" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Serveur" Binding="{Binding Address}" Width="2*" SortDirection="Ascending" />
                            <DataGridTextColumn Header="Utilisateur" Binding="{Binding UserName}" Width="1.3*" />
                            <DataGridTextColumn Header="Domaine" Binding="{Binding LogonDomain}" Width="*" />
                            <DataGridTextColumn Header="Plateforme" Binding="{Binding PlatformId}" Width="1.3*" />
                            <DataGridTextColumn Header="Safe" Binding="{Binding SafeName}" Width="1.3*" />
                            <DataGridTextColumn Header="Machines autorisées" Binding="{Binding RemoteMachines}" Width="1.5*" />
                            <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
