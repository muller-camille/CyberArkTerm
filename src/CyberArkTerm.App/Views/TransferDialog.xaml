<Window x:Class="CyberArkTerm.App.Views.TransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="ItemText" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
        <ProgressBar x:Name="Bar" Height="12" Maximum="100" />
        <TextBlock x:Name="SummaryText" Foreground="Gray" Margin="0,6,0,12" />
        <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" HorizontalAlignment="Right" Click="OnCancel" />
    </StackPanel>
</Window>
