<Window x:Class="CyberArkTerm.App.Views.ParallelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.ParallelTitle}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="{x:Static loc:Strings.ParallelDialogIntro}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <Border BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SessionsPanel" />
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
        <TextBlock Text="{x:Static loc:Strings.ParallelDialogBroadcast}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ShowButton" Content="{x:Static loc:Strings.ParallelShow}" IsDefault="True" Click="OnShow" />
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
