<Window x:Class="CyberArkTerm.App.Views.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.AddAccountTitle}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Image Source="{StaticResource IconPermissions}" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" Text="{x:Static loc:Strings.AddAccountTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="IntroText" Text="{x:Static loc:Strings.AddAccountIntro}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="16,4,16,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CreateButton" Content="{x:Static loc:Strings.AddAccountCreate}" IsDefault="True" Click="OnCreate" />
                <Button x:Name="CancelButton" Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="{x:Static loc:Strings.AddAccountCreating}" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Visibility="Collapsed" />
        </DockPanel>

        <Grid Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{x:Static loc:Strings.AddAccountSafe}" Target="{Binding ElementName=SafeBox}" />
            <ComboBox Grid.Column="1" x:Name="SafeBox" IsEditable="True" Margin="0,0,0,8" />
            <Label Grid.Row="1" Content="{x:Static loc:Strings.AddAccountPlatform}" Target="{Binding ElementName=PlatformBox}" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PlatformBox" IsEditable="True" Margin="0,0,0,8"
                      ToolTip="{x:Static loc:Strings.AddAccountPlatformTip}" />
            <Label Grid.Row="2" Content="{x:Static loc:Strings.AddAccountAddress}" Target="{Binding ElementName=AddressBox}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="AddressBox" Margin="0,0,0,8" VerticalContentAlignment="Center" />
            <Label Grid.Row="3" Content="{x:Static loc:Strings.AddAccountUser}" Target="{Binding ElementName=UserBox}" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="UserBox" Margin="0,0,0,8" VerticalContentAlignment="Center" />
            <Label Grid.Row="4" Content="{x:Static loc:Strings.AddAccountDomain}" Target="{Binding ElementName=DomainBox}" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="DomainBox" Margin="0,0,0,8" VerticalContentAlignment="Center"
                     ToolTip="{x:Static loc:Strings.AddAccountDomainTip}" />
            <Label Grid.Row="5" Content="{x:Static loc:Strings.AddAccountName}" Target="{Binding ElementName=NameBox}" />
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8" VerticalContentAlignment="Center"
                     ToolTip="{x:Static loc:Strings.AddAccountNameTip}" />
            <Label Grid.Row="6" x:Name="PasswordLabel" Content="{x:Static loc:Strings.AddAccountPassword}" Target="{Binding ElementName=PasswordBox}" />
            <PasswordBox Grid.Row="6" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,8" VerticalContentAlignment="Center"
                         ToolTip="{x:Static loc:Strings.AddAccountPasswordTip}" />
            <Label Grid.Row="7" x:Name="ConfirmLabel" Content="{x:Static loc:Strings.AddAccountConfirm}" Target="{Binding ElementName=ConfirmBox}" />
            <PasswordBox Grid.Row="7" Grid.Column="1" x:Name="ConfirmBox" Margin="0,0,0,8" VerticalContentAlignment="Center" />
            <Label Grid.Row="8" Content="{x:Static loc:Strings.AddAccountMachines}" Target="{Binding ElementName=MachinesBox}" />
            <TextBox Grid.Row="8" Grid.Column="1" x:Name="MachinesBox" Margin="0,0,0,8" VerticalContentAlignment="Center"
                     ToolTip="{x:Static loc:Strings.AddAccountMachinesTip}" />
            <CheckBox Grid.Row="9" Grid.Column="1" x:Name="CpmBox" IsChecked="True" Margin="0,2,0,8"
                      Checked="OnCpmChanged" Unchecked="OnCpmChanged">
                <AccessText Text="{x:Static loc:Strings.AddAccountCpm}" />
            </CheckBox>
            <Label Grid.Row="10" Content="{x:Static loc:Strings.AddAccountReason}" Target="{Binding ElementName=ReasonBox}" />
            <TextBox Grid.Row="10" Grid.Column="1" x:Name="ReasonBox" Margin="0,0,0,8" VerticalContentAlignment="Center" IsEnabled="False" />
            <TextBlock Grid.Row="11" Grid.ColumnSpan="2" x:Name="ErrorMessage" Foreground="Firebrick" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,4" />
        </Grid>
    </DockPanel>
</Window>
