<Window x:Class="CyberArkTerm.App.Views.SafeMembersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CyberArkTerm.App.Views"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.SafeMembersTitle}" Width="1000" Height="560" MinWidth="600" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- En-tête sur plusieurs lignes ; le texte reste une chaîne pour que Ctrl+C copie le libellé. -->
        <DataTemplate x:Key="WrappedHeader">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" ToolTip="{Binding}" />
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8"
                   Text="{x:Static loc:Strings.SafeMembersLoading}" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" />
            <StackPanel x:Name="ManagePanel" DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0" Visibility="Collapsed">
                <Button x:Name="AddButton" Content="{x:Static loc:Strings.SafeMembersAdd}" Click="OnAddMember" />
                <Button x:Name="EditButton" Content="{x:Static loc:Strings.SafeMembersEdit}" Click="OnEditMember" Margin="8,0,0,0" IsEnabled="False" />
                <Button x:Name="RemoveButton" Content="{x:Static loc:Strings.SafeMembersRemove}" Click="OnRemoveMember" Margin="8,0,0,0" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="HintText" Text="{x:Static loc:Strings.SafeMembersHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" />
        </DockPanel>
        <TextBlock x:Name="RightsText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel x:Name="SummaryPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock x:Name="CanAddText" TextWrapping="Wrap" Margin="0,0,0,6" />
            <CheckBox x:Name="OnlyAddBox" Click="OnOnlyAddClick">
                <AccessText Text="{x:Static loc:Strings.SafeMembersOnlyAdd}" />
            </CheckBox>
        </StackPanel>

        <Grid>
        <!-- Chargement, puis erreur avec « Réessayer » : au centre, à la place du tableau. -->
        <StackPanel x:Name="StatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Width="220" Height="6" Margin="0,0,0,10" />
            <views:ErrorLine x:Name="ErrorMessage" TextAlignment="Center" Visibility="Collapsed" />
            <Button x:Name="RetryButton" Content="{x:Static loc:Strings.Retry}" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Visibility="Collapsed" Click="OnRetry" />
        </StackPanel>
        <DataGrid x:Name="MembersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" AlternatingRowBackground="{DynamicResource AlternateRowBrush}" ClipboardCopyMode="IncludeHeader"
                  SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnGridDoubleClick" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
