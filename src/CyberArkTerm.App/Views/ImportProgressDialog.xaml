<Window x:Class="CyberArkTerm.App.Views.ImportProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.ImportTitle}" Width="1000" Height="620" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Couleur du résultat : vert si créé, rouge si refusé ou non importé, gris si non envoyé. -->
        <Style x:Key="ResultText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="Created">
                    <Setter Property="Foreground" Value="#1E7B45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Refused">
                    <Setter Property="Foreground" Value="Firebrick" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="NotImported">
                    <Setter Property="Foreground" Value="Firebrick" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="NotSent">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Sending">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Height="6" Margin="0,0,0,8" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="SaveButton" Content="{x:Static loc:Strings.ImportSaveResult}" IsEnabled="False" Click="OnSaveResult" />
                <Button x:Name="StopButton" Content="{x:Static loc:Strings.ImportStop}" Margin="8,0,0,0" Click="OnStop" />
                <Button Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="ProgressText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>

        <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E5E9EE" AlternatingRowBackground="#F7F9FC" ClipboardCopyMode="IncludeHeader" />
    </DockPanel>
</Window>
