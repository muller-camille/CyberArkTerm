<Window x:Class="CyberArkTerm.App.Views.PermissionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.PermissionsTitle}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="TargetText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="PathText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,12" />

        <!-- Cases rwx : une ligne par catégorie, une colonne par droit. -->
        <Grid x:Name="BitsGrid" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.PermissionsRead}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Grid.Column="2" Text="{x:Static loc:Strings.PermissionsWrite}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Grid.Column="3" Text="{x:Static loc:Strings.PermissionsExecute}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.PermissionsOwner}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.PermissionsGroup}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Text="{x:Static loc:Strings.PermissionsOthers}" VerticalAlignment="Center" />
        </Grid>

        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="{x:Static loc:Strings.PermissionsSpecial}" Width="110" VerticalAlignment="Center" />
            <CheckBox x:Name="SetUidBox" Content="setuid" ToolTip="{x:Static loc:Strings.SetUidTip}" Margin="0,0,16,0" Click="OnSpecialClick" />
            <CheckBox x:Name="SetGidBox" Content="setgid" ToolTip="{x:Static loc:Strings.SetGidTip}" Margin="0,0,16,0" Click="OnSpecialClick" />
            <CheckBox x:Name="StickyBox" Content="sticky" ToolTip="{x:Static loc:Strings.StickyTip}" Click="OnSpecialClick" />
        </DockPanel>

        <DockPanel Margin="0,0,0,8">
            <Label Content="{x:Static loc:Strings.PermissionsOctal}" Target="{Binding ElementName=OctalBox}" Width="110" Padding="0,4" />
            <TextBox x:Name="OctalBox" Width="70" HorizontalAlignment="Left" FontFamily="Consolas, Courier New" MaxLength="4"
                     TextChanged="OnOctalChanged" VerticalContentAlignment="Center" />
            <TextBlock x:Name="SymbolicText" FontFamily="Consolas, Courier New" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </DockPanel>

        <StackPanel x:Name="RecursivePanel" Visibility="Collapsed" Margin="0,4,0,8">
            <CheckBox x:Name="RecursiveBox" Click="OnRecursiveClick">
                <AccessText Text="{x:Static loc:Strings.PermissionsRecursive}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox x:Name="SmartExecuteBox" IsChecked="True" IsEnabled="False" Margin="20,6,0,0">
                <AccessText Text="{x:Static loc:Strings.PermissionsSmartExecute}" TextWrapping="Wrap" />
            </CheckBox>
        </StackPanel>

        <TextBlock Text="{x:Static loc:Strings.PermissionsHint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="{x:Static loc:Strings.Ok}" IsDefault="True" Click="OnOk" />
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
