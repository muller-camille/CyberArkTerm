<Window x:Class="CyberArkTerm.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.PromptTitle}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,12">
            <Image Source="{StaticResource IconSsh}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock x:Name="InstructionText" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
        <PasswordBox x:Name="SecretBox" Margin="0,0,0,12" />
        <TextBox x:Name="TextBox" Margin="0,0,0,12" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static loc:Strings.Ok}" IsDefault="True" Click="OnOk" />
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
