<Window x:Class="CyberArkTerm.App.Views.SafeMemberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.SafeMembersTitle}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeadingText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{x:Static loc:Strings.SafeMemberIntro}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,10" />

        <Grid x:Name="IdentityGrid" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{x:Static loc:Strings.SafeMemberName}" Target="{Binding ElementName=NameBox}" />
            <TextBox Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8" VerticalContentAlignment="Center" ToolTip="{x:Static loc:Strings.SafeMemberNameTip}" />
            <Label Grid.Column="3" Content="{x:Static loc:Strings.SafeMemberTypeLabel}" Target="{Binding ElementName=TypeBox}" />
            <ComboBox Grid.Column="4" x:Name="TypeBox" Margin="0,0,0,8" />
            <Label Grid.Row="1" x:Name="SearchInLabel" Content="{x:Static loc:Strings.SafeMemberSearchIn}" Target="{Binding ElementName=SearchInBox}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SearchInBox" Text="Vault" Margin="0,0,0,8" VerticalContentAlignment="Center"
                     ToolTip="{x:Static loc:Strings.SafeMemberSearchInTip}" />
            <Label Grid.Row="1" Grid.Column="3" Content="{x:Static loc:Strings.SafeMemberUntil}" Target="{Binding ElementName=UntilBox}" />
            <DatePicker Grid.Row="1" Grid.Column="4" x:Name="UntilBox" Margin="0,0,0,8" ToolTip="{x:Static loc:Strings.SafeMemberUntilTip}" />
        </Grid>

        <!-- Accès et gestion des comptes à gauche, safe, workflow et dossiers à droite (11 droits de chaque côté). -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="LeftGroups" />
            <StackPanel Grid.Column="1" x:Name="RightGroups" />
        </Grid>

        <TextBlock x:Name="ErrorMessage" Foreground="Firebrick" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />
        <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="{x:Static loc:Strings.SafeMemberAll}" Click="OnAll" />
                <Button Content="{x:Static loc:Strings.SafeMemberNone}" Click="OnNone" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="{x:Static loc:Strings.Save}" IsDefault="True" Click="OnSave" />
                <Button x:Name="CancelButton" Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="{x:Static loc:Strings.SafeMemberSaving}" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </DockPanel>
    </StackPanel>
</Window>
