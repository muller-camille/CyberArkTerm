<Window x:Class="CyberArkTerm.App.Views.ImportAccountsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.ImportTitle}" Width="1000" Height="620" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.ImportIntro}" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button x:Name="ChooseButton" Content="{x:Static loc:Strings.ImportChooseFile}" Click="OnChooseFile" Margin="0,0,10,8" />
            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" x:Name="FileText" Text="{x:Static loc:Strings.ImportNoFile}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,8" />
            <Button Grid.Column="3" x:Name="TemplateButton" Content="{x:Static loc:Strings.ImportTemplate}" Click="OnSaveTemplate"
                    HorizontalAlignment="Right" Margin="0,0,0,8" />
            <Label Grid.Row="1" Content="{x:Static loc:Strings.ImportDefaultSafe}" Target="{Binding ElementName=SafeBox}" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SafeBox" IsEditable="True" Margin="0,0,16,0"
                      ToolTip="{x:Static loc:Strings.ImportDefaultsTip}" />
            <Label Grid.Row="1" Grid.Column="2" Content="{x:Static loc:Strings.ImportDefaultPlatform}" Target="{Binding ElementName=PlatformBox}" />
            <ComboBox Grid.Row="1" Grid.Column="3" x:Name="PlatformBox" IsEditable="True" ToolTip="{x:Static loc:Strings.ImportDefaultsTip}" />
        </Grid>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ImportButton" Content="{x:Static loc:Strings.ImportButton}" IsDefault="True" IsEnabled="False" Click="OnImport" />
                <Button x:Name="StopButton" Content="{x:Static loc:Strings.ImportStop}" Margin="8,0,0,0" Visibility="Collapsed" Click="OnStop" />
                <Button Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="ProgressText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock x:Name="PasswordWarning" Text="{x:Static loc:Strings.ImportPasswordsWarning}" Foreground="#B26A00"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4" />
            <TextBlock x:Name="ErrorMessage" Foreground="Firebrick" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4" />
        </StackPanel>

        <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E5E9EE" AlternatingRowBackground="#F7F9FC" ClipboardCopyMode="IncludeHeader" />
    </DockPanel>
</Window>
