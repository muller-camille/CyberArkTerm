<Window x:Class="CyberArkTerm.App.Views.ImportAccountsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CyberArkTerm.App.Views"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.ImportTitle}" Width="760" SizeToContent="Height" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <StackPanel Margin="16">
        <TextBlock Text="{x:Static loc:Strings.ImportIntro}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <DockPanel Margin="0,0,0,8">
            <Button x:Name="ChooseButton" DockPanel.Dock="Left" Content="{x:Static loc:Strings.ImportChooseFile}" Click="OnChooseFile" />
            <Button x:Name="TemplateButton" DockPanel.Dock="Right" Content="{x:Static loc:Strings.ImportTemplate}" Click="OnSaveTemplate" />
            <TextBlock x:Name="FileText" Text="{x:Static loc:Strings.ImportNoFile}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Margin="10,0,10,0" />
        </DockPanel>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{x:Static loc:Strings.ImportDefaultSafe}" Target="{Binding ElementName=SafeBox}" />
            <ComboBox Grid.Column="1" x:Name="SafeBox" IsEditable="True" Margin="0,0,0,6" ToolTip="{x:Static loc:Strings.ImportDefaultsTip}" />
            <Label Grid.Row="1" Content="{x:Static loc:Strings.ImportDefaultPlatform}" Target="{Binding ElementName=PlatformBox}" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PlatformBox" IsEditable="True" ToolTip="{x:Static loc:Strings.ImportDefaultsTip}" />
        </Grid>

        <DockPanel Margin="0,4,0,4">
            <CheckBox x:Name="OnlyErrorsBox" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="OnOnlyErrors">
                <AccessText Text="{x:Static loc:Strings.ImportOnlyErrors}" />
            </CheckBox>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontWeight="SemiBold" Visibility="Collapsed" VerticalAlignment="Center" />
        </DockPanel>
        <!-- Aperçu de toutes les lignes avant de créer quoi que ce soit (mots de passe jamais affichés). -->
        <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" MaxHeight="240" MinHeight="80"
                  Margin="0,0,0,6" Visibility="Collapsed" AutomationProperties.Name="{x:Static loc:Strings.ImportPreview}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static loc:Strings.ImportColLine}" Binding="{Binding Line}" Width="50" />
                <DataGridTextColumn Header="{x:Static loc:Strings.ImportColStatus}" Binding="{Binding Status}" Width="2*" />
                <DataGridTextColumn Header="{x:Static loc:Strings.ImportColSafe}" Binding="{Binding Safe}" Width="*" />
                <DataGridTextColumn Header="{x:Static loc:Strings.ImportColPlatform}" Binding="{Binding Platform}" Width="*" />
                <DataGridTextColumn Header="{x:Static loc:Strings.ImportColAccount}" Binding="{Binding Account}" Width="2*" />
                <DataGridTextColumn Header="{x:Static loc:Strings.ImportColPassword}" Binding="{Binding Password}" Width="95" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="PasswordWarning" Text="{x:Static loc:Strings.ImportPasswordsWarning}" Foreground="{DynamicResource WarningBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4" />
        <views:ErrorLine x:Name="ErrorMessage" Visibility="Collapsed" Margin="0,0,0,4" />

        <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="ImportButton" Content="{x:Static loc:Strings.ImportButton}" IsDefault="True" IsEnabled="False" Click="OnImport" />
                <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{x:Static loc:Strings.ImportConfirmHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
    </StackPanel>
</Window>
