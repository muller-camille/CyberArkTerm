<Window x:Class="CyberArkTerm.App.Views.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion à la session"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <!-- En-tête : le compte ciblé -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Image x:Name="KindIcon" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailsText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,4,16,16">
            <Button Content="_Se connecter" IsDefault="True" Click="OnConnect" />
            <Button Content="Annuler" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel Margin="16,12,16,8">
            <Border x:Name="ErrorPanel" Background="#FDECEA" BorderBrush="#F5C2BD" BorderThickness="1" CornerRadius="3"
                    Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="#A4262C" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="Type de connexion" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="PsmRadio" Content="PSM (bureau à distance)" GroupName="Mode" Margin="0,0,24,0"
                             Checked="OnModeChanged" />
                <RadioButton x:Name="SshRadio" Content="SSH via PSMP" GroupName="Mode" Checked="OnModeChanged" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="_Composant PSM :" Target="{Binding ElementName=ComponentBox}" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ComponentBox" IsEditable="True" Margin="0,0,0,8" />

                <Label Grid.Row="1" Content="_Machine cible :" Target="{Binding ElementName=MachineBox}" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="MachineBox" IsEditable="True" Margin="0,0,0,8"
                          ToolTip="Serveur sur lequel ouvrir la session (comptes de domaine). Vide : adresse du compte." />

                <Label Grid.Row="2" Content="Moti_f :" Target="{Binding ElementName=ReasonBox}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReasonBox" Margin="0,0,0,8"
                         ToolTip="Obligatoire si la plateforme exige un motif d'accès." />

                <Label Grid.Row="3" Content="_Ticket :" Target="{Binding ElementName=TicketSystemBox}" />
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TicketSystemBox" ToolTip="Système de ticketing (ex. ServiceNow)" />
                    <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=TicketSystemBox}"
                               Text="Système (optionnel)" Margin="6,0,0,0" />
                    <TextBox Grid.Column="2" x:Name="TicketIdBox" ToolTip="Numéro de ticket" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Placeholder}" Tag="{Binding ElementName=TicketIdBox}"
                               Text="N° de ticket (optionnel)" Margin="6,0,0,0" />
                </Grid>
            </Grid>

            <CheckBox x:Name="RememberBox" Margin="140,0,0,10" />
            <TextBlock x:Name="SshHint" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
        </StackPanel>
    </DockPanel>
</Window>
