<UserControl x:Class="CyberArkTerm.App.Views.RdpSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CyberArkTerm.App.Localization">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EEF2F6" BorderBrush="#BAC5D1" BorderThickness="0,0,0,1" Padding="8,3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="FullScreenButton" Content="{x:Static loc:Strings.RdpFullScreen}" ToolTip="{x:Static loc:Strings.RdpFullScreenTip}"
                            Click="OnFullScreen" Padding="10,1" Margin="0,0,6,0" />
                    <Button x:Name="DisconnectButton" Content="{x:Static loc:Strings.RdpDisconnect}" ToolTip="{x:Static loc:Strings.RdpDisconnectTip}"
                            Click="OnDisconnect" Padding="10,1" />
                </StackPanel>
                <Image Source="{StaticResource IconWindows}" Width="16" Height="16" Margin="0,0,6,0" />
                <TextBlock x:Name="StatusLine" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Grid x:Name="Body" Background="#0C0C0C">
            <!-- Le contrôle Bureau à distance (fenêtre Windows) est inséré ici ; rien de WPF ne peut s'afficher par-dessus. -->
            <Border x:Name="Overlay" Background="#0C0C0C">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <Image Source="{StaticResource IconWindows}" Width="44" Height="44" Margin="0,0,0,12" />
                    <TextBlock x:Name="OverlayText" Foreground="White" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="OverlayDetail" Foreground="#9AA5B1" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Button x:Name="ReconnectButton" Content="{x:Static loc:Strings.Reconnect}" Margin="0,16,0,0" HorizontalAlignment="Center"
                            Padding="12,2" Click="OnReconnect" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
