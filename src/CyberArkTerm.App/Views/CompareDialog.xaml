<Window x:Class="CyberArkTerm.App.Views.CompareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.CompareTitle}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,12" />

        <RadioButton x:Name="ServerRadio" GroupName="Target" IsChecked="True" Margin="0,0,0,6">
            <AccessText Text="{x:Static loc:Strings.CompareOnServer}" />
        </RadioButton>
        <Grid Margin="20,0,0,10" IsEnabled="{Binding IsChecked, ElementName=ServerRadio}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{x:Static loc:Strings.CompareServer}" Target="{Binding ElementName=SessionBox}" />
            <ComboBox Grid.Column="1" x:Name="SessionBox" DisplayMemberPath="Label" VerticalAlignment="Center" />
            <Label Grid.Row="1" Content="{x:Static loc:Strings.ComparePath}" Target="{Binding ElementName=RemotePathBox}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="RemotePathBox" FontFamily="Consolas, Courier New" VerticalAlignment="Center" Margin="0,4,0,0"
                     ToolTip="{x:Static loc:Strings.ComparePathTip}" />
        </Grid>

        <RadioButton x:Name="LocalRadio" GroupName="Target" Margin="0,0,0,6">
            <AccessText Text="{x:Static loc:Strings.CompareLocal}" />
        </RadioButton>
        <DockPanel Margin="20,0,0,12" IsEnabled="{Binding IsChecked, ElementName=LocalRadio}">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Browse}" Click="OnBrowse" Margin="8,0,0,0" />
            <TextBox x:Name="LocalPathBox" VerticalContentAlignment="Center" />
        </DockPanel>

        <TextBlock Text="{x:Static loc:Strings.CompareNote}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static loc:Strings.CompareButton}" IsDefault="True" Click="OnCompare" />
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
