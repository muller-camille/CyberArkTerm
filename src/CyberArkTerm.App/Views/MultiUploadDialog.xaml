<Window x:Class="CyberArkTerm.App.Views.MultiUploadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.MultiUploadTitle}" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="{x:Static loc:Strings.MultiUploadIntro}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <!-- Fichiers et dossiers locaux (ajoutés par les boutons ou glissés depuis l'Explorateur). -->
        <DockPanel Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static loc:Strings.MultiUploadAddFiles}" Click="OnAddFiles" />
                <Button Content="{x:Static loc:Strings.MultiUploadAddFolder}" Click="OnAddFolder" Margin="6,0,0,0" />
                <Button x:Name="RemoveButton" Content="{x:Static loc:Strings.MultiUploadRemove}" Click="OnRemove" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Text="{x:Static loc:Strings.MultiUploadFiles}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox x:Name="FilesList" Height="110" SelectionMode="Extended" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
                 Margin="0,0,0,10" />

        <Label Content="{x:Static loc:Strings.MultiUploadDestination}" Target="{Binding ElementName=DestinationBox}" Padding="0,0,0,4" FontWeight="SemiBold" />
        <TextBox x:Name="DestinationBox" FontFamily="Consolas, Courier New" ToolTip="{x:Static loc:Strings.MultiUploadDestinationTip}" Margin="0,0,0,10" />

        <TextBlock Text="{x:Static loc:Strings.MultiUploadServers}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Border BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ServersPanel" />
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="ProtocolText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static loc:Strings.MultiUploadSend}" IsDefault="True" Click="OnSend" />
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
