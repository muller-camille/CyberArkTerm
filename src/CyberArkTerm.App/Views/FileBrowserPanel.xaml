<UserControl x:Class="CyberArkTerm.App.Views.FileBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:CyberArkTerm.App">
    <UserControl.Resources>
        <app:FileIconConverter x:Key="FileIcon" />
        <ContextMenu x:Key="FileMenu" Opened="OnMenuOpened">
            <MenuItem Tag="open" Header="_Ouvrir" Click="OnOpenSelected" FontWeight="SemiBold" />
            <MenuItem Tag="download" Header="_Télécharger…" Click="OnDownload">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconDownload}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Envoyer des fichiers ici…" Click="OnUploadDialog">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconUpload}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="_Nouveau dossier…" Click="OnNewFolder">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconNewFolder}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Tag="delete" Header="_Supprimer (rm)" Click="OnDelete">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconDelete}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Tag="copy" Header="_Copier le chemin" Click="OnCopyPath" />
            <MenuItem Header="_Actualiser" Click="OnRefresh" InputGestureText="F5" />
        </ContextMenu>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource SidePanelBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <DockPanel>
                <Image Source="{StaticResource IconFiles}" Width="18" Height="18" Margin="0,0,6,0" />
                <TextBlock x:Name="HeaderText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Barre d'outils du navigateur -->
            <StackPanel x:Name="Toolbar" Orientation="Horizontal" Margin="-2,6,0,0">
                <Button Style="{StaticResource SmallToolButton}" Click="OnParent" ToolTip="Dossier parent (Retour arrière)">
                    <Image Source="{StaticResource IconUp}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Button Style="{StaticResource SmallToolButton}" Click="OnHome" ToolTip="Dossier personnel">
                    <Image Source="{StaticResource IconHome}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Button Style="{StaticResource SmallToolButton}" Click="OnRefresh" ToolTip="Actualiser (F5)">
                    <Image Source="{StaticResource IconRefresh}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Rectangle Style="{StaticResource ToolSeparator}" Margin="4,3" />
                <Button Style="{StaticResource SmallToolButton}" Click="OnUploadDialog" ToolTip="Envoyer des fichiers (ou glissez-les dans la liste)">
                    <Image Source="{StaticResource IconUpload}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Button Style="{StaticResource SmallToolButton}" Click="OnDownload" ToolTip="Télécharger la sélection">
                    <Image Source="{StaticResource IconDownload}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Button Style="{StaticResource SmallToolButton}" Click="OnNewFolder" ToolTip="Nouveau dossier">
                    <Image Source="{StaticResource IconNewFolder}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Button Style="{StaticResource SmallToolButton}" Click="OnDelete" ToolTip="Supprimer la sélection (Suppr)">
                    <Image Source="{StaticResource IconDelete}" Style="{StaticResource SmallIcon}" />
                </Button>
            </StackPanel>

            <!-- Barre de navigation : chemin courant, modifiable -->
            <Grid Margin="0,6,0,0">
                <TextBox x:Name="PathBox" FontFamily="Consolas, Courier New" Padding="4,4" KeyDown="OnPathKeyDown"
                         ToolTip="Chemin courant : saisissez un chemin puis Entrée" />
            </Grid>

            <DockPanel Margin="0,6,0,0">
                <CheckBox x:Name="HiddenBox" DockPanel.Dock="Right" Content="Cachés" Click="OnHiddenChanged"
                          ToolTip="Afficher les fichiers commençant par un point" />
                <CheckBox x:Name="FollowBox" Content="Suivre le dossier du terminal" Click="OnFollowChanged"
                          ToolTip="Le navigateur se place automatiquement dans le dossier courant du shell (cd)" />
            </DockPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="TransferBar" Height="6" Margin="0,4,0,0" Visibility="Collapsed" Maximum="100" />
            </StackPanel>
        </Border>

        <Grid>
            <ListView x:Name="FileList" BorderThickness="0" Background="White" SelectionMode="Extended" AllowDrop="True"
                      ContextMenu="{StaticResource FileMenu}" KeyDown="OnListKeyDown"
                      DragEnter="OnDragEnter" DragOver="OnDragEnter" DragLeave="OnDragLeave" Drop="OnDrop"
                      VirtualizingPanel.IsVirtualizing="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="2,1" />
                        <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nom" Width="165">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Converter={StaticResource FileIcon}}" Width="16" Height="16" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Taille" Width="62">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Modifié" Width="112" DisplayMemberBinding="{Binding ModifiedText}" />
                        <GridViewColumn Header="Droits" Width="84">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Permissions}" FontFamily="Consolas, Courier New" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Indication pendant le glisser-déposer de fichiers -->
            <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False" Margin="6"
                    Background="#E8E3EEFB" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="6">
                <StackPanel VerticalAlignment="Center" Margin="12">
                    <Image Source="{StaticResource IconUpload}" Width="40" Height="40" />
                    <TextBlock x:Name="DropHintText" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Message : aucune session, connexion en cours, erreur -->
            <Border x:Name="MessagePanel" Background="{StaticResource SidePanelBrush}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Margin="20">
                    <Image Source="{StaticResource IconFiles}" Width="44" Height="44" Opacity="0.7" />
                    <TextBlock x:Name="MessageText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Margin="0,10,0,0" />
                    <Button x:Name="RetryButton" Content="_Réessayer" Click="OnRetry" Visibility="Collapsed"
                            HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
