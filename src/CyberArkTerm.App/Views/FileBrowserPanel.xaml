<UserControl x:Class="CyberArkTerm.App.Views.FileBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:CyberArkTerm.App"
             xmlns:corel="clr-namespace:CyberArkTerm.Core.Localization;assembly=CyberArkTerm.Core"
             xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
             xmlns:views="clr-namespace:CyberArkTerm.App.Views">
    <UserControl.Resources>
        <app:FileIconConverter x:Key="FileIcon" />
        <views:TransferStatusConverter x:Key="TransferStatus" />
        <!-- Transfert de la file : sens, élément → destination, état et avancement, bouton retirer / annuler. -->
        <DataTemplate x:Key="TransferTemplate">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Arrow" Text="⬆" Foreground="#1565C0" Margin="0,0,6,0" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                    <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination, Mode=OneWay}">
                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" → " /><Run Text="{Binding Destination, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="StateText" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource TransferStatus}">
                                <Binding />
                                <Binding Path="State" />
                                <Binding Path="Percent" />
                                <Binding Path="Verifying" />
                                <Binding Path="Packing" />
                                <Binding Path="CancelRequested" />
                                <Binding Path="FileCount" />
                                <Binding Path="CurrentFile" />
                                <Binding Path="Error" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <ProgressBar x:Name="Bar" Height="4" Margin="0,2,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="ItemButton" Grid.Column="2" Content="✕" ToolTip="{x:Static loc:Strings.QueueRemoveTip}" Click="OnCancelTransfer"
                        Margin="6,0,0,0" Padding="6,0" VerticalAlignment="Top" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Upload}" Value="False">
                    <Setter TargetName="Arrow" Property="Text" Value="⬇" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ItemButton" Property="Content" Value="{x:Static loc:Strings.QueueCancel}" />
                    <Setter TargetName="ItemButton" Property="ToolTip" Value="{x:Static loc:Strings.QueueCancelTip}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CancelRequested}" Value="True">
                    <Setter TargetName="ItemButton" Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="ItemButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="ItemButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="StateText" Property="Foreground" Value="Firebrick" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                    <Setter TargetName="ItemButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ContextMenu x:Key="FileMenu" Opened="OnMenuOpened">
            <MenuItem Tag="open" Header="{x:Static loc:Strings.FileOpen}" Click="OnOpenSelected" FontWeight="SemiBold" />
            <MenuItem Tag="download" Header="{x:Static loc:Strings.FileDownload}" Click="OnDownload">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconDownload}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Tag="edit" Header="{x:Static loc:Strings.FileEdit}" Click="OnEdit" InputGestureText="F4">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconEdit}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static loc:Strings.FileUploadHere}" Click="OnUploadDialog">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconUpload}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{x:Static loc:Strings.NewFolderMenu}" Click="OnNewFolder">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconNewFolder}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Tag="delete" Header="{x:Static loc:Strings.FileDelete}" Click="OnDelete">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconDelete}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Tag="chmod" Header="{x:Static loc:Strings.FilePermissions}" Click="OnPermissions">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconPermissions}" Width="16" Height="16" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Tag="copy" Header="{x:Static loc:Strings.FileCopyPath}" Click="OnCopyPath" />
            <MenuItem Header="{x:Static loc:Strings.FileRefresh}" Click="OnRefresh" InputGestureText="F5" />
        </ContextMenu>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource SidePanelBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallToolButton}" Click="OnHistory" ToolTip="{x:Static loc:Strings.HistoryTip}">
                    <Image Source="{StaticResource IconHistory}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Image Source="{StaticResource IconFiles}" Width="18" Height="18" Margin="0,0,6,0" />
                <TextBlock x:Name="HeaderText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Barre d'outils du navigateur -->
            <StackPanel x:Name="Toolbar" Orientation="Horizontal" Margin="-2,6,0,0">
                <Button Style="{StaticResource SmallToolButton}" Click="OnParent" ToolTip="{x:Static loc:Strings.ParentTip}">
                    <Image Source="{StaticResource IconUp}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Button Style="{StaticResource SmallToolButton}" Click="OnHome" ToolTip="{x:Static loc:Strings.HomeTip}">
                    <Image Source="{StaticResource IconHome}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Button Style="{StaticResource SmallToolButton}" Click="OnRefresh" ToolTip="{x:Static loc:Strings.RefreshTip}">
                    <Image Source="{StaticResource IconRefresh}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Rectangle Style="{StaticResource ToolSeparator}" Margin="4,3" />
                <Button Style="{StaticResource SmallToolButton}" Click="OnUploadDialog" ToolTip="{x:Static loc:Strings.UploadTip}">
                    <Image Source="{StaticResource IconUpload}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Button Style="{StaticResource SmallToolButton}" Click="OnDownload" ToolTip="{x:Static loc:Strings.DownloadTip}">
                    <Image Source="{StaticResource IconDownload}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Button Style="{StaticResource SmallToolButton}" Click="OnEdit" ToolTip="{x:Static loc:Strings.EditTip}">
                    <Image Source="{StaticResource IconEdit}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Button Style="{StaticResource SmallToolButton}" Click="OnNewFolder" ToolTip="{x:Static loc:Strings.NewFolder}">
                    <Image Source="{StaticResource IconNewFolder}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Button Style="{StaticResource SmallToolButton}" Click="OnPermissions" ToolTip="{x:Static loc:Strings.PermissionsTip}">
                    <Image Source="{StaticResource IconPermissions}" Style="{StaticResource SmallIcon}" />
                </Button>
                <Button Style="{StaticResource SmallToolButton}" Click="OnDelete" ToolTip="{x:Static loc:Strings.DeleteTip}">
                    <Image Source="{StaticResource IconDelete}" Style="{StaticResource SmallIcon}" />
                </Button>
            </StackPanel>

            <!-- Barre de navigation : chemin courant, modifiable -->
            <Grid Margin="0,6,0,0">
                <TextBox x:Name="PathBox" FontFamily="Consolas, Courier New" Padding="4,4" KeyDown="OnPathKeyDown"
                         ToolTip="{x:Static loc:Strings.PathTip}" />
            </Grid>

            <DockPanel Margin="0,6,0,0">
                <CheckBox x:Name="HiddenBox" DockPanel.Dock="Right" Content="{x:Static loc:Strings.Hidden}" Click="OnHiddenChanged"
                          ToolTip="{x:Static loc:Strings.HiddenTip}" />
                <CheckBox x:Name="FollowBox" Content="{x:Static loc:Strings.FollowTerminal}" Click="OnFollowChanged"
                          ToolTip="{x:Static loc:Strings.FollowTip}" />
            </DockPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <StackPanel>
                <!-- File d'attente des transferts : visible tant qu'une série est en cours. -->
                <Border x:Name="QueuePanel" Visibility="Collapsed" BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="0,0,0,1"
                        Padding="0,0,0,6" Margin="0,0,0,4">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button x:Name="CancelAllButton" DockPanel.Dock="Right" Content="{x:Static loc:Strings.QueueCancelAll}" Padding="6,0"
                                    Click="OnCancelAllTransfers" />
                            <TextBlock Text="{x:Static loc:Strings.QueueTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="QueueList" ItemTemplate="{StaticResource TransferTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <DockPanel>
                    <!-- Détail de la vérification SHA-256 des derniers transferts. -->
                    <TextBlock x:Name="ChecksLink" DockPanel.Dock="Right" Margin="8,0,0,0" Visibility="Collapsed">
                        <Hyperlink Click="OnShowChecks"><Run Text="{x:Static loc:Strings.ChecksLink}" /></Hyperlink>
                    </TextBlock>
                    <!-- Archive .tar.gz envoyée : commande d'extraction à coller dans le terminal. -->
                    <TextBlock x:Name="ExtractLink" DockPanel.Dock="Right" Margin="8,0,0,0" Visibility="Collapsed">
                        <Hyperlink Click="OnCopyExtractCommand"><Run Text="{x:Static loc:Strings.ArchiveCopyCommand}" /></Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Grid>
            <ListView x:Name="FileList" BorderThickness="0" Background="White" SelectionMode="Extended" AllowDrop="True"
                      ContextMenu="{StaticResource FileMenu}" KeyDown="OnListKeyDown"
                      DragEnter="OnDragEnter" DragOver="OnDragEnter" DragLeave="OnDragLeave" Drop="OnDrop"
                      PreviewMouseLeftButtonDown="OnListPreviewMouseDown" PreviewMouseMove="OnListPreviewMouseMove"
                      PreviewMouseLeftButtonUp="OnListPreviewMouseUp"
                      VirtualizingPanel.IsVirtualizing="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="2,1" />
                        <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{x:Static corel:CoreStrings.ColumnName}" Width="165">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Converter={StaticResource FileIcon}}" Width="16" Height="16" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{x:Static loc:Strings.ColumnSize}" Width="76">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{x:Static loc:Strings.ColumnModified}" Width="112" DisplayMemberBinding="{Binding ModifiedText}" />
                        <GridViewColumn Header="{x:Static loc:Strings.ColumnPermissions}" Width="84">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Permissions}" FontFamily="Consolas, Courier New" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Indication pendant le glisser-déposer de fichiers -->
            <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False" Margin="6"
                    Background="#E8E3EEFB" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="6">
                <StackPanel VerticalAlignment="Center" Margin="12">
                    <Image Source="{StaticResource IconUpload}" Width="40" Height="40" />
                    <TextBlock x:Name="DropHintText" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Message : aucune session, connexion en cours, erreur -->
            <Border x:Name="MessagePanel" Background="{StaticResource SidePanelBrush}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Margin="20">
                    <Image Source="{StaticResource IconFiles}" Width="44" Height="44" Opacity="0.7" />
                    <TextBlock x:Name="MessageText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Margin="0,10,0,0" />
                    <Button x:Name="RetryButton" Content="{x:Static loc:Strings.Retry}" Click="OnRetry" Visibility="Collapsed"
                            HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
