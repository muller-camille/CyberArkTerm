<UserControl x:Class="CyberArkTerm.App.Views.SshSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:term="clr-namespace:CyberArkTerm.App.Terminal">
    <Grid Background="#0C0C0C">
        <term:TerminalView x:Name="Terminal" />
        <Border x:Name="Overlay" Background="#D80C0C0C" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <Image Source="{StaticResource IconSsh}" Width="44" Height="44" Margin="0,0,0,12" />
                <TextBlock x:Name="OverlayText" Foreground="White" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="OverlayDetail" Foreground="#9AA5B1" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                <Button x:Name="ReconnectButton" Content="_Reconnecter" Margin="0,16,0,0" HorizontalAlignment="Center"
                        Click="OnReconnect" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
