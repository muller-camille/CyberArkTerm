<Window x:Class="CyberArkTerm.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CyberArkTerm.App.Localization"
        Title="{x:Static loc:Strings.SettingsTitle}"
        Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="{x:Static loc:Strings.LanguageSection}" Style="{StaticResource SectionTitle}" />
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{x:Static loc:Strings.LanguageLabel}" Target="{Binding ElementName=LanguageBox}" />
            <ComboBox Grid.Column="1" x:Name="LanguageBox" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static loc:Strings.LanguageHelp}" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </Grid>

        <TextBlock Text="{x:Static loc:Strings.PvwaSessionSection}" Style="{StaticResource SectionTitle}" />
        <CheckBox x:Name="KeepAliveBox" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Text="{x:Static loc:Strings.KeepAlive}" />
        </CheckBox>

        <TextBlock Text="{x:Static loc:Strings.RdpSection}" Style="{StaticResource SectionTitle}" />
        <CheckBox x:Name="RdpInAppBox" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Text="{x:Static loc:Strings.RdpInApp}" />
        </CheckBox>
        <CheckBox x:Name="RemoteAppInTabBox" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Text="{x:Static loc:Strings.RemoteAppInTab}" />
        </CheckBox>
        <CheckBox x:Name="PsmRemoteAppAsDesktopBox" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Text="{x:Static loc:Strings.PsmRemoteAppAsDesktop}" />
        </CheckBox>

        <TextBlock Text="{x:Static loc:Strings.SettingsSshSection}" Style="{StaticResource SectionTitle}" />
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="{x:Static loc:Strings.SettingsSshHelp}" />
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <Label Content="{x:Static loc:Strings.PsmpAddressLabel}" Target="{Binding ElementName=PsmpBox}" />
            <TextBox Grid.Column="1" x:Name="PsmpBox" VerticalContentAlignment="Center" />
            <Label Grid.Column="2" Content="{x:Static loc:Strings.PortLabel}" Target="{Binding ElementName=PortBox}" Margin="8,0,0,0" />
            <TextBox Grid.Column="3" x:Name="PortBox" VerticalContentAlignment="Center" />
        </Grid>
        <CheckBox x:Name="PreferSshBox" Content="{x:Static loc:Strings.PreferSsh}" Margin="0,4,0,8" />
        <CheckBox x:Name="SshInAppBox" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Text="{x:Static loc:Strings.SshInApp}" />
        </CheckBox>
        <CheckBox x:Name="FollowBox" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Text="{x:Static loc:Strings.FollowSetting}" />
        </CheckBox>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{x:Static loc:Strings.UploadLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <RadioButton x:Name="ScpRadio" Content="SCP" GroupName="Upload" Margin="0,0,16,0" VerticalAlignment="Center" />
            <RadioButton x:Name="SftpRadio" Content="SFTP" GroupName="Upload" VerticalAlignment="Center" />
        </StackPanel>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{x:Static loc:Strings.TextEditorLabel}" Target="{Binding ElementName=EditorBox}" />
            <TextBox Grid.Column="1" x:Name="EditorBox" VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="1" Style="{StaticResource Placeholder}" Tag="{Binding ElementName=EditorBox}"
                       Text="notepad.exe" Margin="6,0,0,0" />
            <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseEditor" Margin="8,0,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Static loc:Strings.TextEditorHelp}"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </Grid>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.ForgetKeys}" Click="OnForgetHostKeys" VerticalAlignment="Center" />
            <TextBlock x:Name="HostKeysText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>

        <TextBlock Text="{x:Static loc:Strings.LocalStoreSection}" Style="{StaticResource SectionTitle}" />
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StoreCreateButton" Content="{x:Static loc:Strings.LocalStoreCreate}" Click="OnStoreCreate" Margin="8,0,0,0" />
                <Button x:Name="StoreUnlockButton" Content="{x:Static loc:Strings.LocalStoreUnlockMenu}" Click="OnStoreUnlock" Margin="8,0,0,0" />
                <Button x:Name="StoreChangeButton" Content="{x:Static loc:Strings.LocalStoreChange}" Click="OnStoreChange" Margin="8,0,0,0" />
                <Button x:Name="StoreDeleteButton" Content="{x:Static loc:Strings.LocalStoreDelete}" Click="OnStoreDelete" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="StoreText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Text="{x:Static loc:Strings.ComponentsSection}" Style="{StaticResource SectionTitle}" />
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Forget}" Click="OnForgetComponents" VerticalAlignment="Center" />
            <TextBlock x:Name="ComponentsText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>

        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static loc:Strings.Save}" IsDefault="True" Click="OnSave" />
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
