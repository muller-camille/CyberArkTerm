<UserControl x:Class="CyberArkTerm.App.Views.FilesSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CyberArkTerm.App.Localization">
    <Grid Background="#F7F9FC">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600" Margin="24">
            <Image Source="{StaticResource IconFiles}" Width="48" Height="48" Margin="0,0,0,12" />
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Foreground="#2B3A4A" />
            <TextBlock x:Name="DetailText" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
            <TextBlock x:Name="StateText" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="13" />
            <!-- FTP sans TLS, accepté par l'utilisateur : rappel permanent. -->
            <Border x:Name="CleartextBanner" Background="#FFF4CE" BorderBrush="#E0C068" BorderThickness="1" CornerRadius="3" Padding="10,6"
                    Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="{x:Static loc:Strings.FtpUnencrypted}" Foreground="#5C4A00" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button x:Name="ShowFilesButton" Content="{x:Static loc:Strings.FilesShow}" Click="OnShowFiles" Padding="12,3" />
                <Button x:Name="ReconnectButton" Content="{x:Static loc:Strings.Reconnect}" Click="OnReconnect" Padding="12,3" Margin="8,0,0,0"
                        Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
