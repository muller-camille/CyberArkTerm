<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Permet de compiler depuis Linux/macOS (CI) ; l'exécution reste Windows uniquement. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CyberArkTerm</AssemblyName>
    <RootNamespace>CyberArkTerm.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CyberArkTerm.Core\CyberArkTerm.Core.csproj" />
  </ItemGroup>

</Project>
