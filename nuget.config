<?xml version="1.0" encoding="utf-8"?>
<!--
  Version de test seulement : SSH.NET vient du dossier local-packages, rempli par la CI (ou à la main) avec le paquet
  compilé depuis le fork muller-camille/SSH.NET au commit b0079ae ; tous les autres paquets viennent de nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="sshnet-patched" value="local-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="sshnet-patched">
      <package pattern="SSH.NET" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
